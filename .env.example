# OpenAI API key for embedding generation
# Never commit real keys. Keep this file as template only.
OPENAI_API_KEY=sk-your-key-here

# Embedding model (default)
EMBEDDING_MODEL=text-embedding-3-small

# Embedding build tuning
# EMBEDDING_BATCH_SIZE=10
# EMBEDDING_BASE_DELAY_MS=200
# EMBEDDING_MAX_RETRIES=3
# EMBEDDING_MAX_TEXT_LENGTH=30000

# WordPress + WooCommerce source sync
WP_SITE_URL=https://example.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxx

# --- OpenClaw Integration ---
# Set OPENCLAW_HOOK_TOKEN to enable automatic notification to OpenClaw
# when embedding pipeline completes. Leave empty for standalone CLI mode.
#
# Generate a token:  openssl rand -hex 32
# This must match the token in your ~/.openclaw/openclaw.json hooks config.
#
# Default gateway URL assumes local OpenClaw on default port.
# Default hook name is "embedding-done" — matches the webhook route in OpenClaw.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789/hooks
OPENCLAW_HOOK_TOKEN=
OPENCLAW_HOOK_NAME=embedding-done
